#ifndef MANIPULATOR_CONFIG_H
#define MANIPULATOR_CONFIG_H
#if defined(K_USE_FLOAT) && K_USE_FLOAT != @K_USE_FLOAT@
#error "K_USE_FLOAT conflicts with installed arithmetic profile"
#endif
#ifndef K_USE_FLOAT
#define K_USE_FLOAT @K_USE_FLOAT@
#endif
#define K_VERSION_MAJOR 0
#define K_VERSION_MINOR 1
#define K_VERSION_PATCH 0
#define K_ABI_VERSION 1
#if K_USE_FLOAT
#define k_model_init k_v1_f32_model_init
#define k_model_validate k_v1_f32_model_validate
#define k_transform_identity k_v1_f32_transform_identity
#define k_transform_validate k_v1_f32_transform_validate
#define k_transform_compose k_v1_f32_transform_compose
#define k_forward k_v1_f32_forward
#define k_forward_frames k_v1_f32_forward_frames
#else
#define k_model_init k_v1_f64_model_init
#define k_model_validate k_v1_f64_model_validate
#define k_transform_identity k_v1_f64_transform_identity
#define k_transform_validate k_v1_f64_transform_validate
#define k_transform_compose k_v1_f64_transform_compose
#define k_forward k_v1_f64_forward
#define k_forward_frames k_v1_f64_forward_frames
#endif
#endif
