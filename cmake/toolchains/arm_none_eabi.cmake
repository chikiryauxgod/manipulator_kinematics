set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
find_program(CMAKE_C_COMPILER arm-none-eabi-gcc HINTS "$ENV{MK_ARM_TOOLCHAIN_DIR}" REQUIRED)
find_program(CMAKE_AR arm-none-eabi-ar HINTS "$ENV{MK_ARM_TOOLCHAIN_DIR}" REQUIRED)
find_program(CMAKE_RANLIB arm-none-eabi-ranlib HINTS "$ENV{MK_ARM_TOOLCHAIN_DIR}" REQUIRED)
find_program(CMAKE_OBJCOPY arm-none-eabi-objcopy HINTS "$ENV{MK_ARM_TOOLCHAIN_DIR}" REQUIRED)
set(CMAKE_C_FLAGS_INIT "-mcpu=cortex-m4 -mthumb -mfloat-abi=soft")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
